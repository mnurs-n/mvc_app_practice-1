<!DOCTYPE html>
<html>
    <head>
        <title>Пользователи</title>
        <meta charset="UTF-8" />
    </head>
    <body>
        <h1>Создать нового пользователя</h1>
        <form actions="/users/create" method="post">
            <label>Имя:</label>
            <input name="username" /> <br><br>
            <label>Возраст:</label>
            <input name="age" type="number" min="1" max="150"/><br><br>
            <input type="submit" value="Отправить"/>
        </form>
    </body>
</html>